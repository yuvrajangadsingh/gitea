{{if or .LeftComments .RightComments}}
	<tr class="add-comment" data-line-type="{{.LineType}}">
		{{if .Split}}
			<td class="add-comment-left" colspan="4">
				{{if .LeftComments}}{{template "repo/diff/commit_conversation" (dict "Comments" .LeftComments)}}{{end}}
			</td>
			<td class="add-comment-right" colspan="4">
				{{if .RightComments}}{{template "repo/diff/commit_conversation" (dict "Comments" .RightComments)}}{{end}}
			</td>
		{{else}}
			<td class="add-comment-left add-comment-right" colspan="5">
				{{if .RightComments}}{{template "repo/diff/commit_conversation" (dict "Comments" .RightComments)}}{{end}}
				{{if .LeftComments}}{{template "repo/diff/commit_conversation" (dict "Comments" .LeftComments)}}{{end}}
			</td>
		{{end}}
	</tr>
{{end}}
